{
  "name": "cipher-logger",
  "version": "1.5.1",
  "description": "See every request. Capture every error. Understand your application.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.mts",
        "default": "./dist/express.mjs"
      },
      "require": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/nuxt.d.mts",
        "default": "./dist/nuxt.mjs"
      },
      "require": {
        "types": "./dist/nuxt.d.ts",
        "default": "./dist/nuxt.js"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.mts",
        "default": "./dist/fastify.mjs"
      },
      "require": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.mts",
        "default": "./dist/nest.mjs"
      },
      "require": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.mts",
        "default": "./dist/hono.mjs"
      },
      "require": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "pnpm run lint && pnpm run build",
    "prepublishOnly": "pnpm run test",
    "commitlint": "commitlint --edit",
    "clean": "rm -rf out dist node_modules/.cache",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherunits/CipherLogger.git"
  },
  "author": "CipherUnits",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/cipherunits/CipherLogger/issues"
  },
  "homepage": "https://github.com/cipherunits/CipherLogger#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "logger",
    "logging",
    "log",
    "logging-library",
    "node-logger",
    "nodejs-logger",
    "javascript-logger",
    "typescript-logger",
    "http-logger",
    "request-logger",
    "error-logger",
    "request-logging",
    "error-logging",
    "monitoring",
    "observability",
    "nextjs",
    "nextjs-logger",
    "nextjs-middleware",
    "nuxt",
    "nuxt-logger",
    "express",
    "express-logger",
    "fastify",
    "fastify-logger",
    "nest",
    "nestjs",
    "nestjs-logger",
    "hono",
    "hono-logger",
    "cipherlogger",
    "cipherunits"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "peerDependencies": {
    "express": ">=4",
    "next": ">=15",
    "nuxt": ">=3",
    "fastify": ">=4",
    "hono": ">=1",
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^26.1.2",
    "express": "^5.1.0",
    "next": "^15.5.2",
    "fastify": "^4.27.0",
    "hono": "^3.3.0",
    "tsup": "^8.5.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  }
}
