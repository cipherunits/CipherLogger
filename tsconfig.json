{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,

    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",

    "types": ["node"],

    "declaration": true,
    "isolatedModules": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
